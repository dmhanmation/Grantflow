# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Primary Gemini model identifier (default: gemini-3.6-flash)
# A reliable, high-performance model suitable for structured extraction and agentic reasoning.
GEMINI_MODEL="gemini-3.6-flash"

# GEMINI_FALLBACK_MODEL: Failover model for temporary 503/high-demand errors (default: gemini-3.7-flash)
GEMINI_FALLBACK_MODEL="gemini-3.7-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Transactional email notifications (Resend)
# Create a Resend API key and use a verified sender/domain for production.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="GrantFlow <notifications@yourdomain.org>"

# Optional secret for Google Cloud Scheduler / notification cron calls.
# If omitted, SCOUT_CRON_SECRET is reused.
NOTIFICATION_CRON_SECRET="YOUR_NOTIFICATION_CRON_SECRET"
